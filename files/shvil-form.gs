/**
 * תכנית שביל - שאלון תחילת שנה
 * קוד לדוגמה לסדנה: יוצר את השאלון בגוגל טפסים.
 * איך מפעילים:
 * 1. פותחים את script.google.com ולוחצים "פרויקט חדש".
 * 2. מוחקים את מה שכתוב שם, ומדביקים את כל הקוד הזה.
 * 3. שומרים (סמל הדיסקט), ולוחצים "הפעלה".
 * 4. בפעם הראשונה: מאשרים הרשאות. אם מופיע מסך אזהרה, לוחצים "מתקדם" ואז "מעבר לפרויקט".
 * 5. הקישורים לשאלון מופיעים ביומן ההרצה למטה, והשאלון נשמר גם בדרייב.
 * הנתונים והתכנית בדויים.
 */
function createShvilForm() {
  var form = FormApp.create('תכנית שביל - שאלון תחילת שנה');
  form.setDescription(
    'שלום, השאלון לוקח כ-5 דקות. אין תשובות נכונות או לא נכונות.\n' +
    'במקום שם, כתבו את קוד המשתתף שקיבלתם. כך נוכל להשוות לשאלון של סוף השנה, בלי לדעת מי אתם.'
  );

  form.addTextItem()
    .setTitle('קוד משתתף')
    .setHelpText('למשל: SH-001')
    .setRequired(true);

  var agree = [
    'אני מרגיש/ה שאני שייך/ת למכללה',
    'יש לי במכללה לפחות אדם אחד שאני יכול/ה לפנות אליו כשקשה לי',
    'אני בטוח/ה שאצליח בקורסים שלי השנה',
    'כשאני לא מבין/ה חומר בקורס, אני יודע/ת למי לפנות',
    'אני יודע/ת אילו שירותי תמיכה יש במכללה ואיך מגיעים אליהם'
  ];
  agree.forEach(function (q) { addScale(form, q); });

  form.addListItem()
    .setTitle('בחודש האחרון, כמה פעמים פנית לשירות תמיכה במכללה? (מרכז למידה, ייעוץ, דיקנט)')
    .setChoiceValues(['0', '1', '2', '3', '4 ומעלה'])
    .setRequired(true);

  [
    'אני דואג/ת לגבי היכולת שלי לממן את הלימודים',
    'אני מרגיש/ה בודד/ה במכללה',
    'אני מתכנן/ת להמשיך ללמוד במכללה בשנה הבאה'
  ].forEach(function (q) { addScale(form, q); });

  form.addTextItem()
    .setTitle('כמה שעות בשבוע את/ה עובד/ת בשכר בתקופה הזו?');

  form.addParagraphTextItem()
    .setTitle('מה הדבר שהכי מדאיג אותך לקראת השנה הראשונה?');

  Logger.log('קישור לעריכה: ' + form.getEditUrl());
  Logger.log('קישור למילוי: ' + form.getPublishedUrl());
}

function addScale(form, title) {
  form.addScaleItem()
    .setTitle(title)
    .setBounds(1, 5)
    .setLabels('בכלל לא מסכים/ה', 'מסכים/ה מאוד')
    .setRequired(true);
}
